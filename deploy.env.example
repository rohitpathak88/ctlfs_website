# Copy to deploy.env on the Ubuntu server and adjust values.
#   cp deploy.env.example deploy.env

# Absolute path to the WordPress site root on the server
DEPLOY_PATH=/var/www/ctlfs

# Git remote (HTTPS or SSH)
# HTTPS: https://github.com/rohitpathak88/ctlfs_website.git
# SSH:   git@github.com:rohitpathak88/ctlfs_website.git
REPO_URL=git@github.com:rohitpathak88/ctlfs_website.git

# Branch to deploy
DEPLOY_BRANCH=main

# Web server user/group (Nginx on Ubuntu 24)
WEB_USER=www-data
WEB_GROUP=www-data

# Optional: deploy key for private repos (SSH)
# GIT_SSH_KEY=/home/deploy/.ssh/ctlfs_deploy

# Optional: write deploy logs here (needs write permission)
# LOG_FILE=/var/log/ctlfs-deploy.log

# Atomic releases (0 = in-place git pull/reset, 1 = releases/ + current symlink)
USE_RELEASES=0
KEEP_RELEASES=5

# ---------------------------------------------------------------------------
# LEMP install (Nginx + MySQL + PHP)
# ---------------------------------------------------------------------------
PHP_VERSION=8.3
TIMEZONE=Asia/Kolkata
INSTALL_WP_CLI=1

# Leave blank to auto-generate (saved to /root/.ctlfs-db.env)
MYSQL_ROOT_PASSWORD=
DB_NAME=ctlfs
DB_USER=ctlfs
DB_PASSWORD=
DB_HOST=localhost

# ---------------------------------------------------------------------------
# SSL / HTTPS (Let's Encrypt)
# ---------------------------------------------------------------------------
# Primary domain (A/AAAA DNS must point to this server)
DOMAIN=ctlfs.in

# Optional www host
WWW_DOMAIN=www.ctlfs.in

# Required for certificate registration
SSL_EMAIL=admin@ctlfs.in

# nginx | apache
WEB_SERVER=nginx

# Update WordPress siteurl/home to https://DOMAIN after cert issue
SSL_FORCE_HTTPS=1

# 1 = Let's Encrypt staging certs (for testing; browsers will warn)
SSL_STAGING=0
